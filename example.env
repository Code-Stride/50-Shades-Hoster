# 🤖 BLAZE NXT Hosting Bot - Configuration Template
# Rename this file to .env and fill in your values

# [REQUIRED] Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# [REQUIRED] Your Telegram User ID (Get it from @userinfobot)
OWNER_ID=123456789

# [OPTIONAL] Admin Telegram User ID (Defaults to OWNER_ID if left empty)
ADMIN_ID=

# [OPTIONAL] Your Telegram Username (without @, e.g. Code_Stride)
YOUR_USERNAME=your_username_here

# [OPTIONAL] Telegram Channel Username for mandatory subscriptions/updates (without @, e.g. MyChannel)
UPDATE_CHANNEL=update_channel_here

# [OPTIONAL] Port for Flask Keep-Alive Server (Defaults to 8080)
PORT=8080
